# MongoDB connection string
MONGODB_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/Ishop?retryWrites=true&w=majority

# Server port (Render sets this automatically)
PORT=5000

# JWT secret
SECRET_KEY=your_secret_key_here

# Email credentials
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# CORS — set this in Render → Environment Variables
FRONTEND_URL=https://your-vercel-frontend-domain.vercel.app

# Public backend URL used for local image links when Cloudinary is off
BACKEND_URL=http://localhost:5000

# Cloudinary — get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
